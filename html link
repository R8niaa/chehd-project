        <button class="nav-btn" onclick="go(1)">→</button>
    </div>

    <script>
        const TOTAL = 11;
        let cur = 0;
        let quizAnswered = false;

        // Build dots
        const dotsEl = document.getElementById('dots');
        for (let i = 0; i < TOTAL; i++) {
            const d = document.createElement('div');
            d.className = 'dot' + (i === 0 ? ' on' : '');
            d.onclick = () => goTo(i);
            dotsEl.appendChild(d);
        }

        function updateUI() {
            document.getElementById('counter').textContent = `${cur + 1} / ${TOTAL}`;
            document.getElementById('prog').style.width = `${((cur + 1) / TOTAL) * 100}%`;
            document.querySelectorAll('.dot').forEach((d, i) => d.className = 'dot' + (i === cur ? ' on' : ''));
        }

        function goTo(n) {
            const slides = document.querySelectorAll('.slide');
            slides[cur].classList.remove('active');
            slides[cur].classList.add('exit');
            setTimeout(() => slides[cur].classList.remove('exit'), 500);
            cur = Math.max(0, Math.min(TOTAL - 1, n));
            slides[cur].classList.add('active');
            updateUI();
        }

        function go(d) { goTo(cur + d); }

        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowRight' || e.key === ' ') go(1);
            if (e.key === 'ArrowLeft') go(-1);
        });

        // Quiz interaction
        function answerQuiz(letter) {
            if (quizAnswered) return;
            document.getElementById('reveal-btn').classList.remove('hidden');
        }

        function revealAnswer() {
            quizAnswered = true;
            ['A', 'B', 'C', 'D'].forEach(l => {
                const el = document.getElementById('q' + l);
                if (l === 'B') el.classList.add('correct-ans');
                else el.classList.add('wrong-ans');
            });
            document.getElementById('reveal-btn').style.display = 'none';
        }

        // QR code for final slide — points to QCM file
        new QRCode(document.getElementById("final-qr"), {
            text: "https://claude.ai",
            width: 148, height: 148,
            colorDark: "#f97316",
            colorLight: "#f5f0e8",
            correctLevel: QRCode.CorrectLevel.M
        });

        updateUI();
    </script>
