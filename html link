<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>L'Enquête de l'Atelier — Cas Clinique 23</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        :root {
            --black: #060608;
            --dark: #0c0d12;
            --card: #13151e;
            --border: #1f2333;
            --orange: #f97316;
            --amber: #f59e0b;
            --red: #dc2626;
            --cream: #f5f0e8;
            --muted: #6b7280;
            --text: #e8e6e1;
            --text2: #9ca3af;
            --green: #22c55e;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: var(--black)
        }

        body {
            font-family: 'Crimson Pro', Georgia, serif;
            color: var(--text)
        }

        /* ── SLIDE ENGINE ── */
        .deck {
            width: 100vw;
            height: 100vh;
            position: relative
        }

        .slide {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4vw 6vw;
            opacity: 0;
            pointer-events: none;
            transition: opacity .5s ease, transform .5s ease;
            transform: translateX(60px);
            overflow: hidden;
        }

        .slide.active {
            opacity: 1;
            pointer-events: all;
            transform: translateX(0)
        }

        .slide.exit {
            opacity: 0;
            transform: translateX(-60px)
        }

        /* ── NAV ── */
        .nav {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 1.2rem;
            background: rgba(13, 15, 20, .85);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 50px;
            padding: .6rem 1.4rem;
            z-index: 100;
        }

        .nav-btn {
            background: none;
            border: none;
            color: var(--muted);
            cursor: pointer;
            font-size: 1.1rem;
            padding: .3rem .6rem;
            border-radius: 6px;
            transition: all .2s;
            font-family: 'Crimson Pro', serif;
        }

        .nav-btn:hover {
            color: var(--orange);
            background: rgba(249, 115, 22, .1)
        }

        .slide-counter {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: var(--muted);
            letter-spacing: .1em;
            min-width: 48px;
            text-align: center;
        }

        .dot-row {
            display: flex;
            gap: .4rem;
            align-items: center
        }

        .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--border);
            transition: all .3s;
            cursor: pointer
        }

        .dot.on {
            background: var(--orange);
            width: 18px;
            border-radius: 4px
        }

        /* ── PROGRESS BAR ── */
        .prog {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: var(--orange);
            transition: width .4s ease;
            z-index: 200
        }

        /* keyboard hint */
        .key-hint {
            position: fixed;
            bottom: 5.5rem;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem;
            color: var(--muted);
            letter-spacing: .1em;
            opacity: .6;
        }

        /* ══════════════════════════════════
   SLIDE 0 — COVER
══════════════════════════════════ */
        #s0 {
            background: var(--black);
            background-image:
                repeating-linear-gradient(0deg, transparent, transparent 49px, rgba(249, 115, 22, .04) 49px, rgba(249, 115, 22, .04) 50px),
                repeating-linear-gradient(90deg, transparent, transparent 49px, rgba(249, 115, 22, .04) 49px, rgba(249, 115, 22, .04) 50px);
        }

        .cover-tape {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: repeating-linear-gradient(90deg, var(--orange) 0, var(--orange) 24px, var(--amber) 24px, var(--amber) 48px);
        }

        .cover-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: .75rem;
            letter-spacing: .2em;
            color: var(--orange);
            text-transform: uppercase;
            margin-bottom: 1.4rem;
            opacity: 0;
            animation: fadeUp .6s .2s ease forwards;
        }

        .cover-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(4rem, 12vw, 9rem);
            line-height: .92;
            letter-spacing: .02em;
            text-align: center;
            color: var(--cream);
            opacity: 0;
            animation: fadeUp .7s .4s ease forwards;
            position: relative;
        }

        .cover-title .accent {
            color: var(--orange);
            display: block
        }

        .cover-subtitle {
            font-size: 1.1rem;
            font-style: italic;
            color: var(--text2);
            margin-top: 1.4rem;
            text-align: center;
            opacity: 0;
            animation: fadeUp .6s .7s ease forwards;
            letter-spacing: .02em;
        }

        .cover-case {
            position: absolute;
            bottom: 3.5rem;
            right: 4vw;
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            color: var(--muted);
            letter-spacing: .12em;
            text-align: right;
            opacity: 0;
            animation: fadeUp .5s 1s ease forwards;
        }

        .cover-stamp {
            position: absolute;
            top: 3rem;
            left: 4vw;
            border: 3px solid var(--red);
            color: var(--red);
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.8rem;
            padding: .3rem .8rem;
            letter-spacing: .1em;
            transform: rotate(-8deg);
            opacity: 0;
            animation: stampIn .4s 1.1s ease forwards;
        }

        @keyframes stampIn {
            from {
                opacity: 0;
                transform: rotate(-8deg) scale(1.4)
            }

            to {
                opacity: 1;
                transform: rotate(-8deg) scale(1)
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        /* ══════════════════════════════════
   SLIDE 1 — ACTE 1 HEADER
══════════════════════════════════ */
        .act-slide {
            background: var(--dark)
        }

        .act-number {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(8rem, 20vw, 16rem);
            color: rgba(249, 115, 22, .07);
            position: absolute;
            right: -2vw;
            bottom: -3vh;
            line-height: 1;
            pointer-events: none;
            letter-spacing: -.02em;
        }

        .act-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .8rem;
            letter-spacing: .2em;
            color: var(--orange);
            margin-bottom: .8rem;
        }

        .act-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2.5rem, 7vw, 5.5rem);
            line-height: 1;
            color: var(--cream);
            margin-bottom: 1rem;
        }

        .act-desc {
            font-size: 1.15rem;
            font-style: italic;
            color: var(--text2);
            max-width: 580px;
            line-height: 1.7;
        }

        .act-line {
            width: 60px;
            height: 3px;
            background: var(--orange);
            margin-bottom: 1.2rem
        }

        /* ══════════════════════════════════
   SLIDE 2 — PORTRAIT KARIM
══════════════════════════════════ */
        .portrait-slide {
            background: var(--dark);
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 4vw;
            align-items: center;
        }

        .portrait-left {}

        .portrait-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            letter-spacing: .18em;
            color: var(--red);
            text-transform: uppercase;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .portrait-label::before {
            content: '';
            width: 24px;
            height: 2px;
            background: var(--red)
        }

        .portrait-name {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            line-height: 1;
            color: var(--cream);
            margin-bottom: 1.2rem;
        }

        .portrait-facts {
            display: flex;
            flex-direction: column;
            gap: .7rem
        }

        .fact {
            display: flex;
            align-items: baseline;
            gap: .8rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: .7rem;
        }

        .fact-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem;
            color: var(--muted);
            letter-spacing: .12em;
            min-width: 90px;
            flex-shrink: 0;
        }

        .fact-value {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.4
        }

        .fact-value .hl {
            color: var(--orange);
            font-weight: 600
        }

        .portrait-right {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .portrait-right::before {
            content: 'DOSSIER\A PATIENT';
            white-space: pre;
            font-family: 'Bebas Neue', sans-serif;
            font-size: 4rem;
            color: rgba(249, 115, 22, .05);
            position: absolute;
            bottom: -1rem;
            right: -1rem;
            line-height: 1;
            letter-spacing: .05em;
            text-align: right;
        }

        .atelier-visual {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .vis-row {
            display: flex;
            align-items: center;
            gap: .8rem;
            font-size: .9rem;
            color: var(--text2);
            line-height: 1.5;
        }

        .vis-icon {
            font-size: 1.6rem;
            flex-shrink: 0;
            width: 36px;
            text-align: center
        }

        .vis-bar {
            margin-top: .3rem;
            height: 4px;
            border-radius: 2px;
            background: linear-gradient(90deg, var(--orange) var(--w), var(--border) var(--w));
        }

        /* ══════════════════════════════════
   SLIDE 3 — SCÈNE DE CRIME
══════════════════════════════════ */
        .crime-slide {
            background: var(--black);
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 3vw;
            align-items: center;
        }

        .crime-left {}

        .crime-headline {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2rem, 5vw, 3.8rem);
            line-height: 1.05;
            color: var(--cream);
            margin-bottom: 1rem;
        }

        .crime-headline .villain {
            color: var(--red)
        }

        .crime-body {
            font-size: 1rem;
            color: var(--text2);
            line-height: 1.8;
            margin-bottom: 1.4rem;
            border-left: 2px solid var(--orange);
            padding-left: 1rem;
            font-style: italic;
        }

        .timeline-mini {
            display: flex;
            flex-direction: column;
            gap: .6rem
        }

        .tm-item {
            display: flex;
            align-items: center;
            gap: .8rem;
            font-size: .88rem;
            color: var(--text2);
        }

        .tm-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .tm-dot.r {
            background: var(--red)
        }

        .tm-dot.o {
            background: var(--orange)
        }

        .tm-dot.g {
            background: var(--green)
        }

        .tm-year {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            color: var(--muted);
            min-width: 44px;
        }

        .crime-right {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .evidence-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.1rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
            overflow: hidden;
            transition: border-color .3s;
        }

        .evidence-card::after {
            content: 'PIÈCE À CONVICTION';
            font-family: 'JetBrains Mono', monospace;
            font-size: .5rem;
            letter-spacing: .15em;
            color: rgba(249, 115, 22, .2);
            position: absolute;
            top: .4rem;
            right: .6rem;
        }

        .ev-num {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 2.2rem;
            color: var(--orange);
            line-height: 1;
            min-width: 36px;
        }

        .ev-body {}

        .ev-title {
            font-size: .85rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: .2rem
        }

        .ev-desc {
            font-size: .8rem;
            color: var(--muted);
            line-height: 1.4
        }

        /* ══════════════════════════════════
   SLIDE 4 — ACTE 2 HEADER
══════════════════════════════════ */

        /* ══════════════════════════════════
   SLIDE 5 — PREUVES PARACLINIQUES
══════════════════════════════════ */
        .proof-slide {
            background: var(--dark);
            display: grid !important;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5vw;
            align-items: start;
            padding-top: 3rem !important;
        }

        .proof-header {
            grid-column: 1/-1;
            margin-bottom: .5rem;
        }

        .proof-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            letter-spacing: .2em;
            color: var(--orange);
            margin-bottom: .4rem;
        }

        .proof-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(1.8rem, 4vw, 3rem);
            color: var(--cream);
        }

        .proof-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 1.4rem;
            transition: border-color .3s, transform .3s;
        }

        .proof-card:hover {
            border-color: var(--orange);
            transform: translateY(-4px)
        }

        .pc-icon {
            font-size: 2rem;
            margin-bottom: .8rem
        }

        .pc-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .62rem;
            letter-spacing: .15em;
            color: var(--muted);
            margin-bottom: .3rem;
        }

        .pc-name {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.4rem;
            color: var(--cream);
            margin-bottom: .5rem
        }

        .pc-result {
            font-size: .88rem;
            color: var(--text2);
            line-height: 1.6;
            border-top: 1px solid var(--border);
            padding-top: .7rem;
            margin-top: .5rem;
        }

        .pc-result .pos {
            color: var(--green);
            font-weight: 600
        }

        .pc-result .neg {
            color: var(--red);
            font-weight: 600
        }

        .pc-result .warn {
            color: var(--orange);
            font-weight: 600
        }

        /* bar chart */
        .mini-bar-wrap {
            margin-top: .8rem
        }

        .mini-bar-label {
            display: flex;
            justify-content: space-between;
            font-size: .7rem;
            color: var(--muted);
            margin-bottom: .3rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .mini-bar {
            height: 8px;
            border-radius: 4px;
            background: var(--border);
            overflow: hidden;
            margin-bottom: .4rem
        }

        .mini-fill {
            height: 100%;
            border-radius: 4px;
            animation: fillBar 1.2s ease forwards
        }

        @keyframes fillBar {
            from {
                width: 0
            }

            to {
                width: var(--w)
            }
        }

        .mini-fill.orange {
            background: var(--orange)
        }

        .mini-fill.green {
            background: var(--green)
        }

        .mini-fill.red {
            background: var(--red)
        }

        /* ══════════════════════════════════
   SLIDE 6 — ACTE 3 / VERDICT
══════════════════════════════════ */
        .verdict-slide {
            background: var(--black);
            background-image: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(220, 38, 38, .06) 0%, transparent 70%);
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 4vw;
            align-items: center;
        }

        .verdict-left {}

        .verdict-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .2em;
            color: var(--red);
            margin-bottom: .8rem;
        }

        .verdict-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2.5rem, 6vw, 5rem);
            line-height: 1;
            color: var(--cream);
            margin-bottom: 1rem;
        }

        .verdict-box {
            background: rgba(220, 38, 38, .08);
            border: 1px solid rgba(220, 38, 38, .3);
            border-radius: 12px;
            padding: 1.2rem;
            margin-bottom: 1rem;
        }

        .vb-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .62rem;
            letter-spacing: .15em;
            color: var(--red);
            margin-bottom: .4rem;
        }

        .vb-value {
            font-size: 1rem;
            color: var(--cream);
            line-height: 1.5
        }

        .verdict-right {
            display: flex;
            flex-direction: column;
            gap: .9rem
        }

        .v-item {
            display: flex;
            gap: .9rem;
            align-items: flex-start;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1rem;
        }

        .v-num {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 2rem;
            color: var(--orange);
            line-height: 1;
            flex-shrink: 0;
            min-width: 32px;
        }

        .v-body {}

        .v-title {
            font-size: .88rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: .2rem
        }

        .v-desc {
            font-size: .8rem;
            color: var(--muted);
            line-height: 1.5
        }

        /* ══════════════════════════════════
   SLIDE 7 — PRÉVENTION
══════════════════════════════════ */
        .prev-slide {
            background: var(--dark);
            display: grid !important;
            grid-template-rows: auto 1fr;
            align-items: start;
            gap: 1.5rem;
            padding-top: 3rem !important;
        }

        .prev-header {
            width: 100%
        }

        .prev-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            letter-spacing: .2em;
            color: var(--green);
            margin-bottom: .4rem
        }

        .prev-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2rem, 5vw, 3.8rem);
            color: var(--cream)
        }

        .prev-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            width: 100%;
            align-items: start;
        }

        .prev-col {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 1.2rem;
            position: relative;
            overflow: hidden;
        }

        .prev-col-letter {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 5rem;
            color: rgba(255, 255, 255, .03);
            position: absolute;
            bottom: -1rem;
            right: -.5rem;
            line-height: 1;
        }

        .col-icon {
            font-size: 1.6rem;
            margin-bottom: .6rem
        }

        .col-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .6rem;
            letter-spacing: .15em;
            color: var(--muted);
            margin-bottom: .3rem;
        }

        .col-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.3rem;
            color: var(--cream);
            margin-bottom: .6rem
        }

        .col-items {
            display: flex;
            flex-direction: column;
            gap: .4rem
        }

        .col-item {
            font-size: .78rem;
            color: var(--text2);
            line-height: 1.4;
            padding-left: .7rem;
            border-left: 2px solid var(--border);
        }

        .col-item.highlight {
            border-left-color: var(--orange);
            color: var(--text)
        }

        /* ══════════════════════════════════
   SLIDE 8 — CERTIFICAT
══════════════════════════════════ */
        .cert-slide {
            background: var(--black);
            display: grid !important;
            grid-template-columns: 1fr 1.1fr;
            gap: 3vw;
            align-items: center;
        }

        .cert-left {}

        .cert-left-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            letter-spacing: .2em;
            color: var(--amber);
            margin-bottom: .6rem
        }

        .cert-left-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2rem, 5vw, 4rem);
            color: var(--cream);
            line-height: 1;
            margin-bottom: 1rem
        }

        .cert-checklist {
            display: flex;
            flex-direction: column;
            gap: .7rem
        }

        .chk {
            display: flex;
            gap: .7rem;
            align-items: flex-start;
            font-size: .88rem;
            color: var(--text2);
            line-height: 1.5
        }

        .chk-icon {
            flex-shrink: 0;
            margin-top: .1rem
        }

        .chk strong {
            color: var(--text)
        }

        .cert-doc {
            background: var(--cream);
            color: #1a1a1a;
            border-radius: 12px;
            padding: 1.8rem;
            font-family: 'Crimson Pro', serif;
